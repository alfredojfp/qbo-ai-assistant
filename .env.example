# QuickBooks OAuth Configuration
# Get these from https://developer.intuit.com/appinfo/console
QB_CLIENT_ID=your_client_id_here
QB_CLIENT_SECRET=your_client_secret_here
QB_REDIRECT_URI=http://localhost:8000/callback
QB_ENV=sandbox
QB_REALM_ID=your_realm_id_here
QB_ACCESS_TOKEN=your_access_token_here
QB_REFRESH_TOKEN=your_refresh_token_here

# LLM Provider Configuration
# Options: openrouter, openai, anthropic
LLM_PROVIDER=openrouter
LLM_API_KEY=your_llm_api_key_here

# Optional: Google Gemini (for OCR features)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backend selector
# Options: native (default), mcp (Intuit MCP Server)
QB_BACKEND=native
