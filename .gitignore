# QuickBooks AI Assistant - Git Ignore File

# =================================================================
# CREDENCIALES Y ARCHIVOS SENSIBLES
# =================================================================
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# =================================================================
# ARCHIVOS GENERADOS AUTOMÁTICAMENTE
# =================================================================
# Chart of Accounts cache
chart_of_accounts.json

# Reportes guardados
saved_reports.json

# Token usage tracking
token_usage.csv
token_usage_report.xlsx

# Templates CSV generados
deposits_template.csv
*_template.csv

# Otros archivos generados
*.xlsx
*.csv
!requirements.txt

# =================================================================
# PYTHON
# =================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =================================================================
# IDEs Y EDITORES
# =================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# =================================================================
# SISTEMA OPERATIVO
# =================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# =================================================================
# LOGS
# =================================================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =================================================================
# BACKUPS
# =================================================================
backups/
*.backup
*.bak
*.old

# =================================================================
# DATOS TEMPORALES
# =================================================================
tmp/
temp/
*.tmp
*.temp

# =================================================================
# DOCKER (si se usa en el futuro)
# =================================================================
.dockerignore
docker-compose.override.yml

# =================================================================
# JUPYTER NOTEBOOKS (si se usan)
# =================================================================
.ipynb_checkpoints/
*.ipynb

# =================================================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# =================================================================
# Archivos de datos de prueba
test_data/
sample_data/

# Archivos de configuración local
config.local.json
settings.local.json

# =================================================================
# DEXTER (v4.0+) — motor batch + reconciliación
# =================================================================
# Base de datos del motor batch (SQLite, regenerable)
data/*.db
data/dexter.db
data/dexter.db-journal
data/dexter.db-wal
data/dexter.db-shm

# Reportes CSV de reconciliación (se regeneran al re-correr)
data/recon_*.csv
data/bills_preview_*.csv

# Historial de clasificaciones bank feed (test artifact)
bank_feed_classification_history.json

# Manuales pre-existentes (no se versionan, regenerables)
manual-completo-final.pdf
manual-completo-final.tex

# =================================================================
# NOTAS
# =================================================================
# Este .gitignore protege:
# 1. Credenciales sensibles (.env)
# 2. Archivos generados automáticamente (JSON, CSV, Excel)
# 3. Entornos virtuales de Python
# 4. Archivos de IDEs
# 5. Logs y archivos temporales
# 
# Asegúrate de revisar antes de hacer commit que no subes
# información sensible o archivos innecesarios.
# =================================================================
