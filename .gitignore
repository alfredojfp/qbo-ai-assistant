# QuickBooks AI Assistant - Git Ignore File

# =================================================================
# CREDENCIALES Y ARCHIVOS SENSIBLES (MÁXIMA PRIORIDAD)
# =================================================================
.env
.env.*
.env.local
.env.*.local
*.key
*.pem
credentials.json
*token*.json
*secret*.json

# =================================================================
# ARCHIVOS GENERADOS AUTOMÁTICAMENTE
# =================================================================
# Chart of Accounts cache
chart_of_accounts.json

# Reportes guardados
saved_reports.json

# Token usage tracking
token_usage.csv
token_usage_report.xlsx

# Templates CSV generados (permitir solo el template vacío si es necesario)
deposits_template.csv

# Archivos CSV con datos reales de clientes/transacciones
bank_*.csv
reconciliation_*.csv
preview_bills*.csv
*_processed.csv
outputs/*.csv
Backups/*.csv

# Reportes Excel generados
outputs/*.xlsx
reports/*.xlsx

# =================================================================
# PDFS Y FACTURAS (INFORMACIÓN SENSIBLE DE CLIENTES)
# =================================================================
# Carpetas con facturas procesadas/pendientes
Pending bills/
Processed bills/
bills/*.pdf
facturas/*.pdf

# Bloquear todos los PDFs excepto documentación
*.pdf
# Excepciones (documentación que SÍ se versiona)
!docs/*.pdf
!manual-completo-final.pdf

# =================================================================
# PYTHON
# =================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =================================================================
# IDEs Y EDITORES
# =================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# =================================================================
# SISTEMA OPERATIVO
# =================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# =================================================================
# LOGS
# =================================================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =================================================================
# BACKUPS
# =================================================================
Backups/
Backup/
backups/
*.backup
*.bak
*.old

# =================================================================
# DATOS TEMPORALES
# =================================================================
tmp/
temp/
*.tmp
*.temp

# =================================================================
# DOCKER (si se usa en el futuro)
# =================================================================
.dockerignore
docker-compose.override.yml

# =================================================================
# JUPYTER NOTEBOOKS (si se usan)
# =================================================================
.ipynb_checkpoints/
*.ipynb

# =================================================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# =================================================================
# Archivos de datos de prueba con información real
test_data/
sample_data/
Test/
test_results.json

# Archivos de configuración local
config.local.json
settings.local.json

# Carpetas de output con datos sensibles
outputs/
reports/

# Carpetas con datos de reconciliación bancaria
Bank Reconciliation/

# =================================================================
# AUTONOMÍA - Archivos generados por módulos de aprendizaje
# =================================================================
autonomia/learned_patterns.json
autonomia/user_preferences.json
autonomia/classification_history.db
autonomia/*.db
autonomia/*.sqlite

# =================================================================
# NOTAS IMPORTANTES
# =================================================================
# Este .gitignore protege:
# 1. ✅ Credenciales sensibles (.env, tokens, keys)
# 2. ✅ Archivos generados automáticamente (JSON, CSV, Excel)
# 3. ✅ PDFs con facturas de clientes
# 4. ✅ Entornos virtuales de Python
# 5. ✅ Archivos de IDEs y sistema operativo
# 6. ✅ Logs y archivos temporales
# 7. ✅ Datos de aprendizaje de módulos de autonomía
# 8. ✅ Carpetas de backup y reconciliación bancaria
# 9. ✅ Carpetas de testing con datos reales
# 
# ⚠️ VERIFICACIÓN OBLIGATORIA ANTES DE CADA COMMIT:
#    git status
#    git diff --cached
# 
# Asegúrate de que NO aparecen:
# - Archivos .env
# - CSVs con datos reales de clientes
# - PDFs de facturas
# - Archivos token_usage.csv
# - Archivos chart_of_accounts.json con datos reales
# - Carpetas: Backup/, Bank Reconciliation/, Test/
# =================================================================

